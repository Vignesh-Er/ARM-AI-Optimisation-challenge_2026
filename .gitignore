# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

outputs/models/*.h5
outputs/models/*.tflite
!outputs/models/tier1_fixture.tflite
!outputs/models/tier2_fixture.tflite
!outputs/models/tier1_release.tflite
!outputs/models/tier2_release.tflite
# Keep the plots for the README, but ignore raw data if we generated any
outputs/data/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# C / CMake build output (paci_core, bench, tests)
build/
cmake-build-*/
*.o
*.obj
*.a
*.elf
*.bin
*.map
*.su

# Arm tooling (FVP install, not vendored)
Corstone-300/
FVP_Corstone_SSE-300*/
*.axf.map

# Raw per-target measurement JSON is regenerated by bench/report.py on
# every run and is not meant to be diffed as source; the rendered reports
# under outputs/reports/ ARE committed (matches the project's existing
# convention of keeping benchmark_report.md/.json as reviewable snapshots)
outputs/bench/*.json

# Generated CMSIS-NN weight headers (tools/export_cmsisnn.py) are derived
# from trained model binaries that are themselves gitignored above — like
# those .tflite/.h5 files, regenerate via
# tools/train_fixture_models.py && tools/export_cmsisnn.py rather than
# committing large generated weight arrays (paci_params.h stays committed:
# it's generated from committed config.py, not from an ungitted binary).
paci_core/include/tier1_weights.h
paci_core/include/tier2_weights.h

# Editor
.vscode/
.idea/
